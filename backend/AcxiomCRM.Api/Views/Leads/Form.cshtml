@model LeadFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Lead" : "Add Lead";
}

@await Html.PartialAsync("_PageHeader", (isEdit ? "Edit Lead" : "Add Lead", (string?)"Fields marked * are mandatory. Enter at least an email or a phone number."))

<div class="card">
    <div class="card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="LeadName" class="form-label">Lead Name <span class="text-danger">*</span></label>
                    <input asp-for="LeadName" class="form-control" />
                    <span asp-validation-for="LeadName" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CompanyName" class="form-label">Company Name</label>
                    <input asp-for="CompanyName" class="form-control" />
                    <span asp-validation-for="CompanyName" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control"
                           data-val-atleastone="Enter at least an email or a phone number." data-val-atleastone-fields="Email,Phone" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label">Phone</label>
                    <input asp-for="Phone" type="tel" class="form-control" maxlength="10" />
                    <span asp-validation-for="Phone" class="field-validation-error"></span>
                    <div class="form-text">10 digit mobile number</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Source" class="form-label">Source <span class="text-danger">*</span></label>
                    <select asp-for="Source" asp-items="Model.Sources" class="form-select"></select>
                    <span asp-validation-for="Source" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label">Status <span class="text-danger">*</span></label>
                    <select asp-for="Status" asp-items="Model.Statuses" class="form-select" data-val="true" data-val-required="Status is required."></select>
                    <span asp-validation-for="Status" class="field-validation-error"></span>
                    @if (isEdit)
                    {
                        <div class="form-text">Only allowed next statuses are shown. Use Convert on the details page to convert.</div>
                    }
                </div>
                <div class="col-md-4">
                    <label asp-for="Priority" class="form-label">Priority <span class="text-danger">*</span></label>
                    <select asp-for="Priority" asp-items="Model.Priorities" class="form-select"></select>
                    <span asp-validation-for="Priority" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ExpectedValue" class="form-label">Expected Value (₹)</label>
                    <input asp-for="ExpectedValue" type="number" min="0" step="0.01" class="form-control" />
                    <span asp-validation-for="ExpectedValue" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AssignedTo" class="form-label">Assigned Sales Executive</label>
                    <select asp-for="AssignedTo" asp-items="Model.Users" class="form-select"></select>
                    <span asp-validation-for="AssignedTo" class="field-validation-error"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" rows="3" class="form-control"></textarea>
                    <span asp-validation-for="Notes" class="field-validation-error"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">@(isEdit ? "Update Lead" : "Save Lead")</button>
                @if (isEdit)
                {
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                }
                else
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // re-check the "email or phone" rule when the phone changes
        $('#Phone').on('input', function () { if ($('#Email').closest('form').data('validator')) $('#Email').valid(); });
    </script>
}
