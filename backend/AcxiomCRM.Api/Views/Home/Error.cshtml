@{
    ViewData["Title"] = "Error";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
}
<div class="text-center py-5 @(User.Identity?.IsAuthenticated == true ? "" : "card")">
    <i class="bi bi-exclamation-triangle display-3 text-warning"></i>
    <h2 class="mt-3">Something went wrong</h2>
    <p class="text-muted">Please try again. If the problem continues, contact the administrator.</p>
    <a href="/" class="btn btn-primary">Go to Dashboard</a>
</div>
