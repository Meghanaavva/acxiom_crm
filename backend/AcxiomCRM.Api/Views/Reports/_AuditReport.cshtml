@model PagedResult<AuditLogDto>?
@if (Model == null) { return; }

<div class="table-responsive">
    <table class="table table-hover table-sm align-middle mb-0">
        <thead>
            <tr>
                @Ui.SortHeader(Context.Request, "createdAt", "Date / Time")
                @Ui.SortHeader(Context.Request, "userName", "User")
                @Ui.SortHeader(Context.Request, "action", "Action")
                @Ui.SortHeader(Context.Request, "entityName", "Module")
                <th>Record</th>
                @Ui.SortHeader(Context.Request, "result", "Result")
                <th>Details</th>
                <th>IP Address</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Data.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No records found.</td></tr>
            }
            @foreach (var r in Model.Data)
            {
                <tr>
                    <td class="text-nowrap">@Ui.DateTime(r.CreatedAt)</td>
                    <td>@(r.UserName ?? "-")</td>
                    <td>@r.Action</td>
                    <td>@r.EntityName</td>
                    <td>@(r.RecordId ?? "-")</td>
                    <td>@Ui.Badge(r.Result)</td>
                    <td class="small text-break">@(r.Details ?? "-")</td>
                    <td class="small">@(r.IpAddress ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pagination" model="Model.Pagination" />
