@model PagedResult<CustomerReportRow>?
@if (Model == null) { return; }

<div class="table-responsive">
    <table class="table table-hover table-sm align-middle mb-0">
        <thead>
            <tr>
                @Ui.SortHeader(Context.Request, "customerCode", "Code")
                @Ui.SortHeader(Context.Request, "customerName", "Customer")
                @Ui.SortHeader(Context.Request, "companyName", "Company")
                <th>Email</th>
                <th>Phone</th>
                @Ui.SortHeader(Context.Request, "status", "Status")
                <th>Owner</th>
                @Ui.SortHeader(Context.Request, "createdAt", "Created")
            </tr>
        </thead>
        <tbody>
            @if (Model.Data.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No records found.</td></tr>
            }
            @foreach (var r in Model.Data)
            {
                <tr>
                    <td class="text-nowrap">@r.CustomerCode</td>
                    <td><a asp-controller="Customers" asp-action="Details" asp-route-id="@r.Id">@r.CustomerName</a></td>
                    <td>@(r.CompanyName ?? "-")</td>
                    <td>@r.Email</td>
                    <td>@r.Phone</td>
                    <td>@Ui.Badge(r.Status)</td>
                    <td>@r.AssignedToName</td>
                    <td class="text-nowrap">@Ui.Date(r.CreatedAt)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pagination" model="Model.Pagination" />
