@model PagedResult<OpportunityReportRow>?
@if (Model == null) { return; }

<div class="table-responsive">
    <table class="table table-hover table-sm align-middle mb-0">
        <thead>
            <tr>
                @Ui.SortHeader(Context.Request, "opportunityName", "Opportunity")
                <th>Customer</th>
                @Ui.SortHeader(Context.Request, "stage", "Stage")
                @Ui.SortHeader(Context.Request, "amount", "Amount")
                @Ui.SortHeader(Context.Request, "probability", "Probability")
                <th>Weighted</th>
                @Ui.SortHeader(Context.Request, "expectedCloseDate", "Close Date")
                <th>Owner</th>
                @Ui.SortHeader(Context.Request, "createdAt", "Created")
            </tr>
        </thead>
        <tbody>
            @if (Model.Data.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-muted py-4">No records found.</td></tr>
            }
            @foreach (var r in Model.Data)
            {
                <tr>
                    <td><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@r.Id">@r.OpportunityName</a></td>
                    <td>@r.CustomerName</td>
                    <td>@Ui.Badge(r.Stage)</td>
                    <td class="text-nowrap">@Ui.Currency(r.Amount)</td>
                    <td>@r.Probability%</td>
                    <td class="text-nowrap">@Ui.Currency(r.WeightedAmount)</td>
                    <td class="text-nowrap">@Ui.Date(r.ExpectedCloseDate)</td>
                    <td>@r.AssignedToName</td>
                    <td class="text-nowrap">@Ui.Date(r.CreatedAt)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pagination" model="Model.Pagination" />
