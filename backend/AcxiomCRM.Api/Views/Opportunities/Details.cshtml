@model OpportunityDetailsViewModel
@{
    var o = Model.Opportunity;
    ViewData["Title"] = o.OpportunityName;
    var canDelete = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager);
    var isOpen = o.Status == "Open";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h4 mb-0">@o.OpportunityName</h1>
        <p class="text-muted small mb-0">@o.CustomerName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
        @if (isOpen)
        {
            <a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        }
        @if (canDelete)
        {
            <form asp-action="Delete" asp-route-id="@o.Id" method="post" data-confirm="Are you sure you want to delete @o.OpportunityName?" data-confirm-button="Delete">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            </form>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">Opportunity Information</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-4"><div class="small text-muted">Stage</div>@Ui.Badge(o.Stage)</div>
                    <div class="col-sm-4"><div class="small text-muted">Status</div>@Ui.Badge(o.Status)</div>
                    <div class="col-sm-4">
                        <div class="small text-muted">Customer</div>
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@o.CustomerId" class="fw-semibold">@o.CustomerName</a>
                    </div>
                    <div class="col-sm-4"><div class="small text-muted">Amount</div><div class="fw-semibold">@Ui.Currency(o.Amount)</div></div>
                    <div class="col-sm-4"><div class="small text-muted">Probability</div><div class="fw-semibold">@o.Probability%</div></div>
                    <div class="col-sm-4"><div class="small text-muted">Weighted Amount</div><div class="fw-semibold">@Ui.Currency(o.WeightedAmount)</div></div>
                    <div class="col-sm-4"><div class="small text-muted">Expected Close Date</div><div>@Ui.Date(o.ExpectedCloseDate)</div></div>
                    <div class="col-sm-4"><div class="small text-muted">Source</div><div>@(o.Source ?? "-")</div></div>
                    <div class="col-sm-4">
                        <div class="small text-muted">Related Lead</div>
                        @if (o.LeadId != null)
                        {
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@o.LeadId">@o.LeadName</a>
                        }
                        else
                        {
                            <div>-</div>
                        }
                    </div>
                    <div class="col-sm-4"><div class="small text-muted">Owner</div><div class="fw-semibold">@o.AssignedToName</div></div>
                    <div class="col-sm-4"><div class="small text-muted">Created On</div><div>@Ui.DateTime(o.CreatedAt)</div></div>
                    <div class="col-sm-4"><div class="small text-muted">Closed On</div><div>@Ui.DateTime(o.ClosedAt)</div></div>
                    <div class="col-12"><div class="small text-muted">Notes</div><div>@(o.Notes ?? "-")</div></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">Pipeline Stage</div>
            <div class="card-body">
                @if (isOpen)
                {
                    <p class="small text-muted mb-2">Move this opportunity to another stage:</p>
                    <div class="d-grid gap-2 mb-3">
                        @foreach (var stage in OpportunityStages.All.Where(s => s != o.Stage))
                        {
                            var closing = stage == OpportunityStages.Won || stage == OpportunityStages.Lost;
                            var buttonClass = stage == OpportunityStages.Won ? "btn-success" : stage == OpportunityStages.Lost ? "btn-outline-danger" : "btn-outline-primary";
                            <form asp-action="ChangeStage" asp-route-id="@o.Id" method="post"
                                  data-confirm="@(closing ? $"Mark {o.OpportunityName} as {stage}? Closed opportunities cannot be edited or reopened." : $"Move {o.OpportunityName} to {stage}?")"
                                  data-confirm-button="@(closing ? $"Mark as {stage}" : "Move")"
                                  data-confirm-variant="@(stage == OpportunityStages.Lost ? "btn-danger" : stage == OpportunityStages.Won ? "btn-success" : "btn-primary")">
                                <input type="hidden" name="stage" value="@stage" />
                                <button type="submit" class="btn btn-sm @buttonClass w-100">@(closing ? $"Mark as {stage}" : $"Move to {stage}")</button>
                            </form>
                        }
                    </div>
                    <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@o.Id" asp-route-customerId="@o.CustomerId" class="btn btn-outline-primary w-100">
                        <i class="bi bi-calendar-plus me-1"></i>Schedule Follow-Up
                    </a>
                }
                else
                {
                    <div class="alert @(o.Status == "Won" ? "alert-success" : "alert-secondary") mb-0">
                        This opportunity was <strong>@o.Status</strong> on @Ui.Date(o.ClosedAt). Closed opportunities cannot be changed.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
