@model CustomerFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Customer" : "Add Customer";
}

@await Html.PartialAsync("_PageHeader", (isEdit ? "Edit Customer" : "Add Customer", (string?)"Fields marked * are mandatory"))

<div class="card">
    <div class="card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CustomerName" class="form-label">Customer Name <span class="text-danger">*</span></label>
                    <input asp-for="CustomerName" class="form-control" />
                    <span asp-validation-for="CustomerName" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CompanyName" class="form-label">Company Name</label>
                    <input asp-for="CompanyName" class="form-control" />
                    <span asp-validation-for="CompanyName" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label">Phone <span class="text-danger">*</span></label>
                    <input asp-for="Phone" type="tel" class="form-control" maxlength="10" />
                    <span asp-validation-for="Phone" class="field-validation-error"></span>
                    <div class="form-text">10 digit mobile number</div>
                </div>
                <div class="col-12">
                    <label asp-for="Address" class="form-label">Address</label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="City" class="form-label">City</label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="State" class="form-label">State</label>
                    <input asp-for="State" class="form-control" />
                    <span asp-validation-for="State" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label">Status <span class="text-danger">*</span></label>
                    <select asp-for="Status" asp-items="Model.Statuses" class="form-select"></select>
                    <span asp-validation-for="Status" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AssignedTo" class="form-label">Assigned Sales Executive</label>
                    <select asp-for="AssignedTo" asp-items="Model.Users" class="form-select"></select>
                    <span asp-validation-for="AssignedTo" class="field-validation-error"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" rows="3" class="form-control"></textarea>
                    <span asp-validation-for="Notes" class="field-validation-error"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">@(isEdit ? "Update Customer" : "Save Customer")</button>
                @if (isEdit)
                {
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                }
                else
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
