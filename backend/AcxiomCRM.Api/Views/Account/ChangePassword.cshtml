@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

@await Html.PartialAsync("_PageHeader", ("Change Password", (string?)"You will be logged out after changing the password"))

<div class="card" style="max-width: 520px;">
    <div class="card-body">
        <form asp-action="ChangePassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label">Current Password <span class="text-danger">*</span></label>
                <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">New Password <span class="text-danger">*</span></label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" data-val-passwordpolicy="Password" />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                <div class="form-text">Min 8 characters with upper case, lower case, number and special character. Your last 5 passwords cannot be reused.</div>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirm New Password <span class="text-danger">*</span></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
            <button type="submit" class="btn btn-primary">Change Password</button>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
