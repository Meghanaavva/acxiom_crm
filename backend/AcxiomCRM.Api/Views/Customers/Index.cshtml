@model CustomerIndexViewModel
@{
    ViewData["Title"] = "Customers";
    var canDelete = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h4 mb-0">Customers</h1>
        <p class="text-muted small mb-0">Manage customer master data</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Customer</a>
</div>

<div class="card">
    <div class="card-body">
        <!-- Search and filters (GET form, so the URL can be bookmarked) -->
        <form method="get" class="row g-2 mb-3 auto-submit">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="search" name="search" value="@Model.Query.Search" class="form-control" placeholder="Search by name, email, phone or company" aria-label="Search customers" />
                    <button class="btn btn-outline-primary" type="submit">Search</button>
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select" aria-label="Filter by status">
                    <option value="">All Statuses</option>
                    @foreach (var s in CustomerStatuses.All)
                    {
                        <option value="@s" selected="@(Model.Query.Status == s)">@s</option>
                    }
                </select>
            </div>
            @if (Model.Users.Count > 1)
            {
                <div class="col-md-3">
                    <select name="assignedTo" class="form-select" aria-label="Filter by assigned user">
                        <option value="">All Owners</option>
                        @foreach (var u in Model.Users)
                        {
                            <option value="@u.Value" selected="@(Model.Query.AssignedTo?.ToString() == u.Value)">@u.Text</option>
                        }
                    </select>
                </div>
            }
            <input type="hidden" name="sortBy" value="@Model.Query.SortBy" />
            <input type="hidden" name="sortOrder" value="@Model.Query.SortOrder" />
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        @Ui.SortHeader(Context.Request, "customerCode", "Code")
                        @Ui.SortHeader(Context.Request, "customerName", "Name")
                        @Ui.SortHeader(Context.Request, "companyName", "Company")
                        <th>Email / Phone</th>
                        @Ui.SortHeader(Context.Request, "status", "Status")
                        <th>Assigned To</th>
                        @Ui.SortHeader(Context.Request, "createdAt", "Created")
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Result.Data.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No customers found.</td></tr>
                    }
                    @foreach (var c in Model.Result.Data)
                    {
                        <tr>
                            <td class="text-nowrap">@c.CustomerCode</td>
                            <td><a asp-action="Details" asp-route-id="@c.Id" class="fw-semibold text-decoration-none">@c.CustomerName</a></td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td class="small">
                                <div>@c.Email</div>
                                <div class="text-muted">@c.Phone</div>
                            </td>
                            <td>@Ui.Badge(c.Status)</td>
                            <td>@c.AssignedToName</td>
                            <td class="text-nowrap">@Ui.Date(c.CreatedAt)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary" title="View" aria-label="View @c.CustomerName"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary" title="Edit" aria-label="Edit @c.CustomerName"><i class="bi bi-pencil"></i></a>
                                @if (canDelete)
                                {
                                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-confirm="Are you sure you want to delete @c.CustomerName? This action will be recorded in the audit log." data-confirm-button="Delete">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete @c.CustomerName"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model.Result.Pagination" />
    </div>
</div>
