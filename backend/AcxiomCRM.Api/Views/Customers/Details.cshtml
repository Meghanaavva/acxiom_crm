@model CustomerDetailsViewModel
@{
    var c = Model.Customer;
    var h = Model.History;
    ViewData["Title"] = c.CustomerName;
    var canDelete = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h4 mb-0">@c.CustomerName</h1>
        <p class="text-muted small mb-0">@c.CustomerCode @(c.CompanyName != null ? "· " + c.CompanyName : "")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        @if (canDelete)
        {
            <form asp-action="Delete" asp-route-id="@c.Id" method="post" data-confirm="Are you sure you want to delete @c.CustomerName?" data-confirm-button="Delete">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            </form>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">Customer Information</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-4"><div class="small text-muted">Status</div>@Ui.Badge(c.Status)</div>
                    <div class="col-sm-4"><div class="small text-muted">Email</div><div class="fw-semibold">@c.Email</div></div>
                    <div class="col-sm-4"><div class="small text-muted">Phone</div><div class="fw-semibold">@c.Phone</div></div>
                    <div class="col-sm-4"><div class="small text-muted">Address</div><div>@(c.Address ?? "-")</div></div>
                    <div class="col-sm-4"><div class="small text-muted">City / State</div><div>@(c.City ?? "-") / @(c.State ?? "-")</div></div>
                    <div class="col-sm-4"><div class="small text-muted">Assigned To</div><div class="fw-semibold">@c.AssignedToName</div></div>
                    <div class="col-sm-4"><div class="small text-muted">Created By</div><div>@c.CreatedByName</div></div>
                    <div class="col-sm-4"><div class="small text-muted">Created On</div><div>@Ui.DateTime(c.CreatedAt)</div></div>
                    <div class="col-sm-4"><div class="small text-muted">Last Updated</div><div>@Ui.DateTime(c.UpdatedAt)</div></div>
                    <div class="col-12"><div class="small text-muted">Notes</div><div>@(c.Notes ?? "-")</div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">Quick Actions</div>
            <div class="card-body d-grid gap-2">
                <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@c.Id" class="btn btn-outline-primary"><i class="bi bi-briefcase me-1"></i>Add Opportunity</a>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@c.Id" class="btn btn-outline-primary"><i class="bi bi-calendar-plus me-1"></i>Schedule Follow-Up</a>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@c.Id" class="btn btn-outline-primary"><i class="bi bi-activity me-1"></i>Log Activity</a>
                @if (h.ConvertedFromLead != null)
                {
                    <div class="alert alert-success small mb-0 mt-2">
                        Converted from lead <a asp-controller="Leads" asp-action="Details" asp-route-id="@h.ConvertedFromLead.Id">@h.ConvertedFromLead.LeadCode - @h.ConvertedFromLead.LeadName</a>
                        on @Ui.Date(h.ConvertedFromLead.ConvertedAt)
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Related records (Bootstrap tabs) -->
<div class="card mt-3">
    <div class="card-header bg-white">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-opps" type="button" role="tab">Opportunities (@h.Opportunities.Count)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-followups" type="button" role="tab">Follow-Ups (@h.FollowUps.Count)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-activities" type="button" role="tab">Activities (@h.Activities.Count)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-history" type="button" role="tab">History (@h.AuditLogs.Count)</button></li>
        </ul>
    </div>
    <div class="card-body tab-content">
        <div class="tab-pane fade show active" id="tab-opps" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Name</th><th>Stage</th><th class="text-end">Amount</th><th class="text-end">Probability</th><th>Close Date</th><th>Owner</th></tr></thead>
                    <tbody>
                        @if (h.Opportunities.Count == 0) { <tr><td colspan="6" class="text-muted text-center py-3">No opportunities yet.</td></tr> }
                        @foreach (var o in h.Opportunities)
                        {
                            <tr>
                                <td><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.Id">@o.OpportunityName</a></td>
                                <td>@Ui.Badge(o.Stage)</td>
                                <td class="text-end">@Ui.Currency(o.Amount)</td>
                                <td class="text-end">@o.Probability%</td>
                                <td>@Ui.Date(o.ExpectedCloseDate)</td>
                                <td>@o.AssignedToName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="tab-pane fade" id="tab-followups" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Subject</th><th>Type</th><th>Date</th><th>Status</th><th>Assigned To</th></tr></thead>
                    <tbody>
                        @if (h.FollowUps.Count == 0) { <tr><td colspan="5" class="text-muted text-center py-3">No follow-ups yet.</td></tr> }
                        @foreach (var f in h.FollowUps)
                        {
                            <tr>
                                <td>@f.Subject</td>
                                <td>@f.FollowUpType</td>
                                <td>@Ui.Date(f.FollowUpDate)</td>
                                <td>@Ui.Badge(f.IsOverdue ? "Overdue" : f.Status)</td>
                                <td>@f.AssignedToName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="tab-pane fade" id="tab-activities" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Type</th><th>Subject</th><th>Date</th><th>Status</th><th>Assigned To</th></tr></thead>
                    <tbody>
                        @if (h.Activities.Count == 0) { <tr><td colspan="5" class="text-muted text-center py-3">No activities yet.</td></tr> }
                        @foreach (var a in h.Activities)
                        {
                            <tr>
                                <td>@a.ActivityType</td>
                                <td>@a.Subject</td>
                                <td>@Ui.DateTime(a.ActivityDate)</td>
                                <td>@Ui.Badge(a.Status)</td>
                                <td>@a.AssignedToName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="tab-pane fade" id="tab-history" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Date</th><th>User</th><th>Action</th><th>Details</th></tr></thead>
                    <tbody>
                        @if (h.AuditLogs.Count == 0) { <tr><td colspan="4" class="text-muted text-center py-3">No history.</td></tr> }
                        @foreach (var log in h.AuditLogs)
                        {
                            <tr>
                                <td class="text-nowrap">@Ui.DateTime(log.CreatedAt)</td>
                                <td>@log.UserName</td>
                                <td>@Ui.Badge(log.Action)</td>
                                <td class="small text-break">@(log.Details ?? log.NewValue)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
