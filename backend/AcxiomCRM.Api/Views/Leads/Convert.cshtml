@model LeadConvertViewModel
@{
    var l = Model.Lead;
    ViewData["Title"] = "Convert Lead";
}

@await Html.PartialAsync("_PageHeader", ("Convert Lead", (string?)$"{l.LeadCode} · {l.LeadName}"))

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <p class="small text-muted">
                    A customer will be created from this lead. If a customer with the same email or phone already exists,
                    the lead is linked to that customer instead of creating a duplicate.
                </p>

                <form asp-action="Convert" asp-route-id="@l.Id" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Stage" />

                    <div class="form-check form-switch mb-3">
                        <input asp-for="CreateOpportunity" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="CreateOpportunity" class="form-check-label">Also create an opportunity</label>
                    </div>

                    <fieldset id="opportunityFields">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="OpportunityName" class="form-label">Opportunity Name <span class="text-danger">*</span></label>
                                <input asp-for="OpportunityName" class="form-control" data-val-required="Opportunity Name is required." />
                                <span asp-validation-for="OpportunityName" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Amount" class="form-label">Amount (₹) <span class="text-danger">*</span></label>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control"
                                       data-val-required="Opportunity Amount is required."
                                       data-val-positiveifopen="Opportunity Amount must be greater than 0." data-val-positiveifopen-stagefield="Stage" />
                                <span asp-validation-for="Amount" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Probability" class="form-label">Probability (%) <span class="text-danger">*</span></label>
                                <input asp-for="Probability" type="number" min="0" max="100" class="form-control" data-val-required="Probability is required." />
                                <span asp-validation-for="Probability" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ExpectedCloseDate" class="form-label">Expected Close Date <span class="text-danger">*</span></label>
                                <input asp-for="ExpectedCloseDate" type="date" class="form-control" min="@DateHelper.Today().ToString("yyyy-MM-dd")"
                                       data-val="true" data-val-required="Expected Close Date is required."
                                       data-val-notpastifopen="Expected Close Date cannot be in the past." data-val-notpastifopen-stagefield="Stage" />
                                <span asp-validation-for="ExpectedCloseDate" class="field-validation-error"></span>
                            </div>
                        </div>
                    </fieldset>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success"><i class="bi bi-arrow-repeat me-1"></i>Convert Lead</button>
                        <a asp-action="Details" asp-route-id="@l.Id" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Lead</div>
            <div class="card-body small">
                <div><span class="text-muted">Name:</span> @l.LeadName</div>
                <div><span class="text-muted">Company:</span> @(l.CompanyName ?? "-")</div>
                <div><span class="text-muted">Email:</span> @(l.Email ?? "-")</div>
                <div><span class="text-muted">Phone:</span> @(l.Phone ?? "-")</div>
                <div><span class="text-muted">Expected Value:</span> @Ui.Currency(l.ExpectedValue)</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Opportunity fields are only used (and validated) when the switch is on
        (function () {
            var toggle = document.getElementById('CreateOpportunity');
            var fields = document.getElementById('opportunityFields');
            function update() {
                fields.disabled = !toggle.checked;
                fields.classList.toggle('opacity-50', !toggle.checked);
            }
            toggle.addEventListener('change', update);
            update();
        })();
    </script>
}
