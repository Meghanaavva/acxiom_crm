@model OpportunityFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Opportunity" : "Add Opportunity";
    var today = DateHelper.Today().ToString("yyyy-MM-dd");
}

@await Html.PartialAsync("_PageHeader", (isEdit ? "Edit Opportunity" : "Add Opportunity", (string?)"Fields marked * are mandatory. Use the stage buttons on the details page to mark Won or Lost."))

<div class="card">
    <div class="card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="OpportunityName" class="form-label">Opportunity Name <span class="text-danger">*</span></label>
                    <input asp-for="OpportunityName" class="form-control" />
                    <span asp-validation-for="OpportunityName" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CustomerId" class="form-label">Customer <span class="text-danger">*</span></label>
                    <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
                        <option value="">-- Select customer --</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LeadId" class="form-label">Related Lead</label>
                    <select asp-for="LeadId" asp-items="Model.Leads" class="form-select">
                        <option value="">-- None --</option>
                    </select>
                    <span asp-validation-for="LeadId" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Stage" class="form-label">Stage <span class="text-danger">*</span></label>
                    <select asp-for="Stage" asp-items="Model.Stages" class="form-select"></select>
                    <span asp-validation-for="Stage" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Amount" class="form-label">Amount (₹) <span class="text-danger">*</span></label>
                    <input asp-for="Amount" type="number" step="0.01" class="form-control"
                           data-val-positiveifopen="Opportunity Amount must be greater than 0." data-val-positiveifopen-stagefield="Stage" />
                    <span asp-validation-for="Amount" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Probability" class="form-label">Probability (%) <span class="text-danger">*</span></label>
                    <input asp-for="Probability" type="number" min="0" max="100" class="form-control" />
                    <span asp-validation-for="Probability" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ExpectedCloseDate" class="form-label">Expected Close Date <span class="text-danger">*</span></label>
                    <input asp-for="ExpectedCloseDate" type="date" class="form-control" min="@today"
                           data-val-notpastifopen="Expected Close Date cannot be in the past." data-val-notpastifopen-stagefield="Stage" />
                    <span asp-validation-for="ExpectedCloseDate" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="weightedPreview">Weighted Amount</label>
                    <input id="weightedPreview" class="form-control-plaintext fw-semibold" readonly value="-" aria-describedby="weightedHelp" />
                    <div id="weightedHelp" class="form-text">Amount × Probability / 100</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Source" class="form-label">Source</label>
                    <select asp-for="Source" asp-items="Model.Sources" class="form-select">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="Source" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AssignedTo" class="form-label">Owner</label>
                    <select asp-for="AssignedTo" asp-items="Model.Users" class="form-select"></select>
                    <span asp-validation-for="AssignedTo" class="field-validation-error"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" rows="3" class="form-control"></textarea>
                    <span asp-validation-for="Notes" class="field-validation-error"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">@(isEdit ? "Update Opportunity" : "Save Opportunity")</button>
                @if (isEdit)
                {
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                }
                else
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live weighted amount preview
        (function () {
            var amount = document.getElementById('Amount');
            var probability = document.getElementById('Probability');
            var preview = document.getElementById('weightedPreview');
            var formatter = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 });
            function update() {
                var a = parseFloat(amount.value), p = parseFloat(probability.value);
                preview.value = isNaN(a) || isNaN(p) ? '-' : formatter.format(a * p / 100);
            }
            amount.addEventListener('input', update);
            probability.addEventListener('input', update);
            update();
        })();
    </script>
}
